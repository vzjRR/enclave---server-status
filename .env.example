# ---------------------------------------------------------------
# Enclave RP — Server Status bot
#
# Copy to .env and fill in. chmod 600 it on a server.
# ---------------------------------------------------------------

# Discord application credentials for THIS bot (id 1543975525448683580).
# Create/manage it at https://discord.com/developers/applications.
DISCORD_TOKEN=
CLIENT_ID=1543975525448683580

# The Enclave RP Discord server. Slash commands register here instantly
# (leave empty to register globally, which can take up to an hour to
# propagate) and the bot ignores every other guild it is in.
GUILD_ID=1535571261395312680

# Channel status alerts (down / scheduled restart / back up) are posted
# to, with an @everyone mention.
STATUS_CHANNEL_ID=1536824170720133150

# Comma-separated role ids allowed to run /scheduled-restart. Members
# with Manage Server can always run it regardless of this list.
STAFF_ROLE_ID=

# ---------------------------------------------------------------
# FiveM server to watch
# ---------------------------------------------------------------

# The code from cfx.re/join/<code>. The address is resolved from this on
# every check, so the bot keeps working if the server's IP changes.
FIVEM_JOIN_CODE=dggpkvq

# How often to check the server, in milliseconds.
CHECK_INTERVAL_MS=60000

# Consecutive failed checks required before announcing the server down.
# Absorbs a single dropped check without crying wolf.
FAILURE_THRESHOLD=2

# Consecutive successful checks required before announcing the server
# back up. 1 means the very next successful check announces it.
RECOVERY_THRESHOLD=1

# How long after a /scheduled-restart announcement the next down/up
# transition is treated as "the announced restart" rather than an
# unplanned outage, in minutes.
RESTART_WINDOW_MINUTES=30

# Overridable so a test setup can point these at a local stub. Unset in
# every real deployment.
FIVEM_JOIN_BASE=
FIVEM_LIST_BASE=
