# ---------------------------------------------------------------
# Enclave RP — Server Status bot
#
# Copy to .env and fill in. chmod 600 it on a server.
# ---------------------------------------------------------------

# Discord application credentials for THIS bot (id 1543975525448683580).
# Create/manage it at https://discord.com/developers/applications.
DISCORD_TOKEN=
CLIENT_ID=1543975525448683580

# The Enclave RP Discord server. Slash commands register here instantly
# (leave empty to register globally, which can take up to an hour to
# propagate) and the bot ignores every other guild it is in.
GUILD_ID=1535571261395312680

# Channel the live status card lives in, and where /server-down,
# /server-up and /scheduled-restart post their @everyone announcements.
STATUS_CHANNEL_ID=1536824170720133150

# Comma-separated role ids allowed to run /server-down, /server-up and
# /scheduled-restart. Members with Manage Server can always run them
# regardless of this list.
STAFF_ROLE_ID=

# ---------------------------------------------------------------
# FiveM server to watch
# ---------------------------------------------------------------

# The code(s) from cfx.re/join/<code>. Comma-separated — every code listed
# is checked on each poll and whichever one answers wins, so it's safe to
# list more than one if you're not sure which is current. The FIRST one
# listed is also what the status card shows as the "connect" command, so
# keep the current/primary code first. The address for each is resolved
# fresh, so the bot keeps working if the server's IP changes.
FIVEM_JOIN_CODE=dggpkvq

# How often to check the server, in milliseconds. Drives both the internal
# online/offline tracking and, indirectly, what the status card shows.
CHECK_INTERVAL_MS=60000

# Consecutive failed checks required before the server is considered down.
# Absorbs a single dropped check without flip-flopping.
FAILURE_THRESHOLD=2

# Consecutive successful checks required before the server is considered
# back up. 1 means the very next successful check counts.
RECOVERY_THRESHOLD=1

# How often the live status card (title/status/players/connect/uptime/next
# restart) is refreshed, in milliseconds.
CARD_UPDATE_INTERVAL_MS=60000

# Overridable so a test setup can point these at a local stub. Unset in
# every real deployment.
FIVEM_JOIN_BASE=
FIVEM_LIST_BASE=

# ---------------------------------------------------------------
# txAdmin scheduled-restart relay
#
# Feeds the status card's "NEXT RESTART" countdown and real UPTIME: the
# txadmin_restart_relay FiveM resource (fivem/txadmin_restart_relay/)
# listens for txAdmin's own restart-scheduler events and heartbeats its
# own start time, POSTing both here. Entirely optional — without it the
# card just shows "Not scheduled" and estimates uptime itself. See that
# resource's README for the game-server side of this setup.
# ---------------------------------------------------------------

# Port the relay endpoint listens on. Unset (default) disables it entirely.
RESTART_WEBHOOK_PORT=8787

# Interface to bind. Loopback by default -- only widen this if the FiveM
# server and this bot run on different hosts, and put a reverse proxy with
# TLS in front rather than exposing it directly.
RESTART_WEBHOOK_HOST=127.0.0.1

# Shared secret the relay resource sends as X-Relay-Secret. Must match
# txadmin_restart_relay_secret in the game server's server.cfg exactly.
# Required for the relay endpoint to start at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RESTART_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# txAdmin's own live status API (direct, no relay resource needed)
#
# When both are set, txAdmin's official GET /host/status endpoint is
# checked on every poll and wins for online/players/join-code whenever it
# answers — it's txAdmin's own authoritative tracking, not an external
# guess. Entirely optional; unset or unreachable, everything falls back to
# the ordinary dynamic.json/listing poll exactly as before.
# ---------------------------------------------------------------

# Base URL where txAdmin's web panel is reachable from this bot, e.g.
# http://GAME_SERVER_IP:40120 (40120 is txAdmin's default port). No
# trailing slash. Must be reachable — open the port to this bot on
# whatever firewall(s) sit between them, same as RESTART_WEBHOOK_PORT.
TXADMIN_URL=

# The TXHOST_API_TOKEN value set as an environment variable for the
# FXServer process itself (NOT a server.cfg convar — see
# https://aka.cfx.re/txadmin-env-config). 16-48 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TXADMIN_API_TOKEN=
