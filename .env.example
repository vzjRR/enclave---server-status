# ---------------------------------------------------------------
# Enclave RP — Server Status bot
#
# Copy to .env and fill in. chmod 600 it on a server.
# ---------------------------------------------------------------

# Discord application credentials for THIS bot (id 1543975525448683580).
# Create/manage it at https://discord.com/developers/applications.
DISCORD_TOKEN=
CLIENT_ID=1543975525448683580

# The Enclave RP Discord server. Slash commands register here instantly
# (leave empty to register globally, which can take up to an hour to
# propagate) and the bot ignores every other guild it is in.
GUILD_ID=1535571261395312680

# Channel status alerts (down / scheduled restart / back up) are posted
# to, with an @everyone mention.
STATUS_CHANNEL_ID=1536824170720133150

# Comma-separated role ids allowed to run /scheduled-restart. Members
# with Manage Server can always run it regardless of this list.
STAFF_ROLE_ID=

# ---------------------------------------------------------------
# FiveM server to watch
# ---------------------------------------------------------------

# The code(s) from cfx.re/join/<code>. Comma-separated — every code listed
# is checked on each poll and whichever one answers wins, so it's safe to
# list more than one if you're not sure which is current. The address for
# each is resolved fresh, so the bot keeps working if the server's IP changes.
FIVEM_JOIN_CODE=zjjp6m4,dggpkvq

# How often to check the server, in milliseconds.
CHECK_INTERVAL_MS=60000

# Consecutive failed checks required before announcing the server down.
# Absorbs a single dropped check without crying wolf.
FAILURE_THRESHOLD=2

# Consecutive successful checks required before announcing the server
# back up. 1 means the very next successful check announces it.
RECOVERY_THRESHOLD=1

# How long after a /scheduled-restart announcement the next down/up
# transition is treated as "the announced restart" rather than an
# unplanned outage, in minutes.
RESTART_WINDOW_MINUTES=30

# Overridable so a test setup can point these at a local stub. Unset in
# every real deployment.
FIVEM_JOIN_BASE=
FIVEM_LIST_BASE=

# ---------------------------------------------------------------
# txAdmin scheduled-restart relay
#
# Makes /scheduled-restart automatic: the txadmin_restart_relay FiveM
# resource (fivem/txadmin_restart_relay/) listens for txAdmin's own
# restart-scheduler events and POSTs them here. See that resource's
# README for the game-server side of this setup.
# ---------------------------------------------------------------

# Port the relay endpoint listens on. Unset (default) disables it entirely
# -- /scheduled-restart still works either way, this is purely additive.
RESTART_WEBHOOK_PORT=8787

# Interface to bind. Loopback by default -- only widen this if the FiveM
# server and this bot run on different hosts, and put a reverse proxy with
# TLS in front rather than exposing it directly.
RESTART_WEBHOOK_HOST=127.0.0.1

# Shared secret the relay resource sends as X-Relay-Secret. Must match
# txadmin_restart_relay_secret in the game server's server.cfg exactly.
# Required for the relay endpoint to start at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RESTART_WEBHOOK_SECRET=

# Comma-separated minutes-before-restart to actually post an @everyone
# alert for. txAdmin fires its countdown event at exactly
# 30/15/10/5/4/3/2/1 minutes out -- pick from that set, or the milestone
# will never match and nothing gets posted.
RESTART_WEBHOOK_MILESTONES=15,1
